      "id": "whole_view_budget",
      "expectation": "budget governs complete view including unread tail; exact length1461 accepted at equal budget",
      "source": "explicit modern view guard, not original bounds"
    },
    {
      "id": "empty_word",
      "expectation": "nonnull zero view and 0/1 remaining bytes throw truncated, without reading storage",
      "source": "GoalCursor u16 take2; modern nonnull guard distinguishes nullptr"
    },
    {
      "id": "extreme_guard",
      "expectation": "null/oversized view and SIZE_MAX start/budget reject bounded view before dereference",

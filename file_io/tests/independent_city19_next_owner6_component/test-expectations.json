    },
    {
      "id": "field_cuts",
      "expectation": "at translated start257 all proper field boundary cuts reject truncation; exact record succeeds",
      "source": "all66 positive raw counts in independent ledger and cursor take guard"
    },
    {
      "id": "version_encoding",
      "expectation": "little-endian6 accepted; big-endian6, near values andffff rejected selected subset",
